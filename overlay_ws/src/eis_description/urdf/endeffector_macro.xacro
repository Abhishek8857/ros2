<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_gripper">
    <xacro:property name="world" value="world"/>
    <xacro:macro name="endeffector" params="prefix">
        <xacro:arg name="pkg_path" default="$(find eis_description)"/>

        <link name="${prefix}endeffector_base_link">
            <visual>
                <geometry>
                    <mesh filename="file://$(arg pkg_path)/meshes/kr240r2900_2/visual/Endeffector.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="file://$(arg pkg_path)/meshes/kr240r2900_2/collision/Endeffector.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="39.022e-3 -5.476e-03 -1.544e-3" rpy="0 0 0" />
                <mass value="2.661" />
                <inertia ixx="8260.609e-6" iyy="49383.692e-6" izz="55629.500e-6" ixy="1956.252e-6" ixz="-3441.965e-6" iyz="441.021e-6" />
            </inertial>
        </link>

        <link name="${prefix}endeffector_plug_link_1">
            <visual>
                <geometry>
                    <mesh filename="file://$(arg pkg_path)/meshes/kr240r2900_2/visual/plug_1.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="file://$(arg pkg_path)/meshes/kr240r2900_2/collision/plug_1.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="185.397e-3 64.928e-03 -1.898e-3" rpy="0 0 0" />
                <mass value="0.025" />
                <inertia ixx="6.791e-6" iyy="7.122e-6" izz="1.328e-6" ixy="0.004e-6" ixz="0.139e-6" iyz="-0.016e-6" />
            </inertial>
        </link>

        <link name="${prefix}endeffector_plug_link_2">
            <visual>
                <geometry>
                    <mesh filename="file://$(arg pkg_path)/meshes/kr240r2900_2/visual/plug_2.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="file://$(arg pkg_path)/meshes/kr240r2900_2/collision/plug_2.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="199.597e-3 65.499e-03 19.830e-3" rpy="0 0 0" />
                <mass value="0.044" />
                <inertia ixx="30.555e-6" iyy="35.948e-6" izz="7.160e-6" ixy="-0.407e-6" ixz="3.837e-6" iyz="0.053e-6" />
            </inertial>
        </link>
        <link name="${prefix}${world}"/>

        <joint name="${prefix}endeffector_base_joint" type="fixed">
            <parent link="${prefix}${world}" />
            <child link="${prefix}endeffector_base_link" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <joint name="${prefix}endeffector_plug_joint_1" type="prismatic">
            <parent link="${prefix}endeffector_base_link" />
            <child link="${prefix}endeffector_plug_link_1" />
            <axis xyz="0 0 -1"/>
            <limit effort="50" lower="-0.01" upper ="0.0338" velocity="0.35"/>
        </joint>

        <joint name="${prefix}endeffector_plug_joint_2" type="prismatic">
            <parent link="${prefix}endeffector_base_link" />
            <child link="${prefix}endeffector_plug_link_2" />
            <axis xyz="0 0 -1"/>
            <limit effort="50" lower="-0.01" upper ="0.0338" velocity="0.35"/>
        </joint>

    </xacro:macro>
</robot>

